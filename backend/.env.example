# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=waste_user
DATABASE_PASSWORD=waste_dev_pass
DATABASE_NAME=waste_management

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRATION=604800

# CORS
CORS_ORIGINS=http://localhost:5173

# Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Firebase FCM (choose one of the two options below)
# Option A: path to service account JSON file (local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/kmertrash-service-account.json
# Option B: full JSON string (CI/CD, Render, Railway, etc.)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"kmertrash",...}

# System Cleanup (Developer Tool)
ALLOW_SYSTEM_CLEANUP=false
DEV_CLEANUP_CODE=CHANGE_ME

# File Storage
#STORAGE_TYPE=local|imgbb|cloudinary
STORAGE_TYPE=local
BASE_URL=http://localhost:3000
UPLOADS_DIR=./uploads

# ImgBB Storage (when STORAGE_TYPE=imgbb)
IMGBB_API_KEY=your_imgbb_api_key

# Cloudinary Storage (when STORAGE_TYPE=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMS Provider (stub|termii|africas-talking|whatsapp)
SMS_PROVIDER=stub

# OTP Dev Mode - Set to true to show OTP in API responses (for testing only)
OTP_DEV_MODE=false

# Termii SMS (when SMS_PROVIDER=termii)
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=KmerTrash

# Africa's Talking SMS (when SMS_PROVIDER=africas-talking)
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=your_africas_talking_username
AT_SENDER_ID=KmerTrash

# WhatsApp Business API (when SMS_PROVIDER=whatsapp)
# Requires Meta Business verification and WhatsApp Business Account setup
WHATSAPP_API_TOKEN=your_meta_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_GRAPH_API_VERSION=v18.0
WHATSAPP_OTP_TEMPLATE_NAME=otp_code
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
