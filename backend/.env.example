# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=waste_user
DATABASE_PASSWORD=waste_dev_pass
DATABASE_NAME=waste_management

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRATION=604800

# CORS
CORS_ORIGINS=http://localhost:5173

# Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Firebase FCM (choose one of the two options below)
# Option A: path to service account JSON file (local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/kmertrash-service-account.json
# Option B: full JSON string (CI/CD, Render, Railway, etc.)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"kmertrash",...}

# System Cleanup (Developer Tool)
ALLOW_SYSTEM_CLEANUP=false
DEV_CLEANUP_CODE=CHANGE_ME
